# Database and authentication
MONGODB_URI=
JWT_SECRET=

# Client URL used by CORS and email links. APP_BASE_URL takes precedence when set.
CLIENT_ORIGIN=http://localhost:5173
APP_BASE_URL=http://localhost:5173

# Gmail SMTP email delivery. EMAIL_APP_PASSWORD must be a Google App Password,
# not the account's normal sign-in password.
EMAIL_USER=unify.web.team@gmail.com
EMAIL_APP_PASSWORD=

# Existing optional services
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
ADMIN_SIGNUP_KEY=
