# Database and authentication
MONGODB_URI=
JWT_SECRET=

# Client URL used by CORS and email links. APP_BASE_URL takes precedence when set.
CLIENT_ORIGIN=http://localhost:5173
APP_BASE_URL=http://localhost:5173

# Resend email delivery. EMAIL_FROM must use a sender verified in Resend for production.
RESEND_API_KEY=
EMAIL_FROM=

# Existing optional services
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
ADMIN_SIGNUP_KEY=
